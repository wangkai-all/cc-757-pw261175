{
  "id": "conflict-locks",
  "title": "互斥锁定样例",
  "note": "虚构数据。同时锁定 {A,B} 与 {A,C} 要求各自成为共同分支，这不可能同时成立；求解器必须报出冲突而不是事后调图。",
  "taxa": [
    { "id": "A", "label": "样品 A" },
    { "id": "B", "label": "样品 B" },
    { "id": "C", "label": "样品 C" },
    { "id": "D", "label": "样品 D" }
  ],
  "features": [
    {
      "id": "H1",
      "name": "虚构性状 H1",
      "ordered": false,
      "states": ["0", "1"],
      "costs": { "0|1": 1 }
    },
    {
      "id": "H2",
      "name": "虚构性状 H2",
      "ordered": false,
      "states": ["0", "1", "2"],
      "costs": { "0|1": 1, "0|2": 2, "1|2": 1 }
    }
  ],
  "matrix": {
    "A": ["0", "0"],
    "B": ["0", "1"],
    "C": ["1", "0"],
    "D": ["1", "2"]
  },
  "constraints": [
    { "id": "L1", "taxa": ["A", "B"], "note": "A 与 B 必须是共同分支" },
    { "id": "L2", "taxa": ["A", "C"], "note": "A 与 C 必须是共同分支" }
  ]
}
